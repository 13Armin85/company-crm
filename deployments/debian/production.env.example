# Generated as .env.production by init-env.sh; edit the generated file on the server.
PUBLIC_URL=CHANGE_ME_PUBLIC_URL
SITE_ADDRESS=CHANGE_ME_SITE_ADDRESS
BIND_ADDRESS=0.0.0.0
ALLOWED_HOSTS=CHANGE_ME_ALLOWED_HOSTS

# Keep these values across deployments and when restoring backups.
# Generated passwords use hex, which is safe in DATABASE_URL without URL encoding.
SECRET_KEY=CHANGE_ME_SECRET_KEY
LIVE_SERVER_SECRET_KEY=CHANGE_ME_LIVE_SERVER_SECRET_KEY
POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY

# Use 1 for an HTTPS public URL, 0 for HTTP on the LAN.
MINIO_ENDPOINT_SSL=0
GUNICORN_WORKERS=2
FILE_SIZE_LIMIT=5242880

# Optional database UI, enabled with --profile tools.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
