FROM node:22.22-alpine

# Match the registry configured in the repository's .npmrc.
ARG NPM_REGISTRY=https://registry.npmmirror.com/

RUN apk add --no-cache libc6-compat \
    && npm install --global pnpm@11.10.0 --registry="$NPM_REGISTRY" \
    && node /usr/local/lib/node_modules/pnpm/bin/pnpm.cjs --version \
    && ln -sf /usr/local/lib/node_modules/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm
WORKDIR /app
ENV HUSKY=0
ENV TURBO_TELEMETRY_DISABLED=1
# Keep installed dependencies cached when only application code changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches/ ./patches/
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/live/package.json ./apps/live/package.json
COPY apps/space/package.json ./apps/space/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/codemods/package.json ./packages/codemods/package.json
COPY packages/constants/package.json ./packages/constants/package.json
COPY packages/decorators/package.json ./packages/decorators/package.json
COPY packages/editor/package.json ./packages/editor/package.json
COPY packages/hooks/package.json ./packages/hooks/package.json
COPY packages/i18n/package.json ./packages/i18n/package.json
COPY packages/logger/package.json ./packages/logger/package.json
COPY packages/propel/package.json ./packages/propel/package.json
COPY packages/services/package.json ./packages/services/package.json
COPY packages/shared-state/package.json ./packages/shared-state/package.json
COPY packages/tailwind-config/package.json ./packages/tailwind-config/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/typescript-config/package.json ./packages/typescript-config/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/utils/package.json ./packages/utils/package.json
RUN --mount=type=cache,id=plane-dev-pnpm,target=/pnpm/store \
    node /usr/local/lib/node_modules/pnpm/bin/pnpm.cjs install --frozen-lockfile --store-dir=/pnpm/store --fetch-timeout=600000 --fetch-retries=5 --network-concurrency=4 --registry="$NPM_REGISTRY"
COPY . .
RUN chmod +x /usr/local/lib/node_modules/pnpm/bin/pnpm.cjs
# Live accepts an env file; Compose supplies its actual configuration.
RUN touch apps/live/.env

CMD ["pnpm", "exec", "turbo", "run", "dev", "--concurrency=20", "--env-mode=loose"]
