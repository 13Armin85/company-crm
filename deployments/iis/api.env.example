# Copy this file to apps/api/.env.
# Values marked SAME_AS_ROOT must exactly match the repository-root .env file.

DEBUG=0
SECRET_KEY=CHANGE_TO_RANDOM_HEX_DJANGO_SECRET
ALLOWED_HOSTS=crm.example.com
CORS_ALLOWED_ORIGINS=https://crm.example.com

POSTGRES_USER=plane
POSTGRES_PASSWORD=SAME_AS_ROOT_POSTGRES_PASSWORD
POSTGRES_HOST=plane-db
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:SAME_AS_ROOT_POSTGRES_PASSWORD@plane-db:5432/plane

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=SAME_AS_ROOT_RABBITMQ_PASSWORD
RABBITMQ_VHOST=plane

AWS_REGION=
AWS_ACCESS_KEY_ID=SAME_AS_ROOT_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=SAME_AS_ROOT_AWS_SECRET_ACCESS_KEY
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
SIGNED_URL_EXPIRATION=3600
USE_MINIO=1
MINIO_ENDPOINT_SSL=1

WEB_URL=https://crm.example.com
APP_BASE_URL=https://crm.example.com
APP_BASE_PATH=
ADMIN_BASE_URL=https://crm.example.com
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://crm.example.com
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=https://crm.example.com
LIVE_BASE_PATH=/live

LIVE_SERVER_SECRET_KEY=SAME_AS_ROOT_LIVE_SERVER_SECRET_KEY
GUNICORN_WORKERS=2
HARD_DELETE_AFTER_DAYS=60
FILE_SIZE_LIMIT=52428800
API_KEY_RATE_LIMIT=60/minute
