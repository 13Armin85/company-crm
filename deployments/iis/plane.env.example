# Copy this file to the repository root as .env.
# Do not commit the resulting .env file.

# PostgreSQL
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_HEX_DATABASE_PASSWORD
POSTGRES_DB=plane
PGDATA=/var/lib/postgresql/data

# Valkey / Redis
REDIS_HOST=plane-redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_TO_RANDOM_HEX_RABBITMQ_PASSWORD
RABBITMQ_VHOST=plane

# Caddy listens only on the VM's private interface; IIS terminates public TLS.
LISTEN_HTTP_PORT=CHANGE_TO_UBUNTU_PRIVATE_IP:8080
LISTEN_HTTPS_PORT=127.0.0.1:8443
SITE_ADDRESS=:80
TRUSTED_PROXIES=CHANGE_TO_WINDOWS_IIS_IP/32
CERT_EMAIL=
CERT_ACME_DNS=

# MinIO
AWS_REGION=
AWS_ACCESS_KEY_ID=CHANGE_TO_RANDOM_HEX_MINIO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_TO_RANDOM_HEX_MINIO_SECRET_KEY
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
USE_MINIO=1
MINIO_ENDPOINT_SSL=1

# Keep this value equal to IIS maxAllowedContentLength.
FILE_SIZE_LIMIT=52428800
API_KEY_RATE_LIMIT=60/minute

# Used by the live collaboration service and must match apps/api/.env.
LIVE_SERVER_SECRET_KEY=CHANGE_TO_RANDOM_HEX_LIVE_SECRET
CORS_ALLOWED_ORIGINS=https://crm.example.com
